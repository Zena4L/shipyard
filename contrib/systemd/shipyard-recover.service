# Starts root's Shipyard containers whose restart policy says so when the
# host starts (`always`; `unless-stopped` unless you stopped it; `on-failure`
# after a failure), and settles what the last boot left. Install it with
# shipyard-stop.service, which stops them at a shutdown. See README.md.
[Unit]
Description=Shipyard: start the containers whose restart policy brings them back
Documentation=https://github.com/Zena4L/shipyard/tree/main/contrib/systemd
Wants=network-online.target shipyard-stop.service
After=network-online.target remote-fs.target shipyard-stop.service

# Stopped (or restarted) with the stop unit: a `systemctl stop
# shipyard-stop` stops the containers, and `systemctl restart shipyard-stop`
# brings them back through this unit's `recover` (which lets restart
# policies go again), as one unit did before 10.2d1.
PartOf=shipyard-stop.service

[Service]
Type=oneshot
# Active once started. Stopping the containers at a shutdown is
# shipyard-stop.service's: a unit's stop runs only once it has started, and
# this one is still starting while it starts the containers at boot (F52).
RemainAfterExit=yes
# Where `shipyard` is installed. A container that couldn't be started (125:
# some, not all) is said in the journal; the unit still counts as started, or
# systemd would end every container it did start. Nothing done at all (1) is
# a failed unit.
ExecStart=/usr/local/bin/shipyard system recover
SuccessExitStatus=125
# At a shutdown this unit is stopped before shipyard-stop (it's ordered
# after it): only its own `recover` process, if it's still starting
# containers. The containers' monitors (in this unit's cgroup where there's
# no cgroup tree) are left for shipyard-stop's `system stop`, which stops
# each with its own stop signal.
KillMode=process
# No limit on the start: it starts each container in turn, and a unit whose
# start times out is stopped.
TimeoutStartSec=infinity

[Install]
WantedBy=multi-user.target
