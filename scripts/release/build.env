# What a release is built with (step 15.5a, F186): the image, by its digest
# (an index: x86-64 and arm64; scripts/test-image/Dockerfile's FROM is the
# same, checked by scripts/release/linux.sh), and musl's tools at their
# version in it. Rust's version is rust-toolchain.toml's.
BUILD_IMAGE=rust:1.98-trixie@sha256:a8a5f0a1e5fe7dfe1d352591e4a1c7dd2c08fd70475cae872cf3458ba0df0546
MUSL_TOOLS=1.2.5-3.1~deb13u1
# Where it's fetched from (step 15.6b3a, F211): Debian's archive as it was
# at this time, on snapshot.debian.org, which keeps every version; the live
# archive drops one at the next point release. Its trixie lists MUSL_TOOLS
# for arm64 and amd64.
DEBIAN_SNAPSHOT=20261120T000000Z
# The SBOMs' tool (scripts/release/sbom.sh).
CYCLONEDX_VERSION=0.5.10
# The Linux packages' tool (scripts/release/packages.sh): its release
# tarball for each architecture, by its SHA-256 (goreleaser's checksums.txt).
NFPM_VERSION=2.48.0
NFPM_SHA256_X86_64=6d7f9a28b2f397934403950fcbba83f598b08d02edbe79a0815b3b4897341750
NFPM_SHA256_ARM64=a9a75213763783b7669719e505474c748c5ad7dc66591a195619deb50f85c2f4
# Where the packages are installed and run in a test
# (scripts/release/test-packages.sh), by index digest.
UBUNTU_IMAGE=ubuntu:24.04@sha256:9c7f200c07e3d4a03e7249d2c16bf66a51120fb876aa2242cf31451412543289
FEDORA_IMAGE=fedora:42@sha256:99e203b80b1c3d8f7e161ec10a68fd02b081ef83a3963553e513c82846b97814
