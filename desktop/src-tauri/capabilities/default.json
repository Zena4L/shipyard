{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "The main window: listening to the core's events, dragging the window by its title bar, and the app's own commands by name. No core:default (no page emit, no paths), no plugin's (the dialog is the core's alone).",
  "windows": ["main"],
  "permissions": [
    "core:event:allow-listen",
    "core:event:allow-unlisten",
    "core:window:allow-start-dragging",
    "allow-status",
    "allow-start-vm",
    "allow-snapshot",
    "allow-links",
    "allow-usage",
    "allow-start-container",
    "allow-stop-container",
    "allow-restart-container",
    "allow-pause-container",
    "allow-unpause-container",
    "allow-remove-container",
    "allow-run-image",
    "allow-images",
    "allow-remove-image",
    "allow-volumes",
    "allow-remove-volume",
    "allow-network-view",
    "allow-isolation",
    "allow-inspect",
    "allow-watch-stats",
    "allow-unwatch-stats",
    "allow-logs-follow",
    "allow-logs-stop",
    "allow-shell-open",
    "allow-shell-input",
    "allow-shell-resize",
    "allow-shell-ack",
    "allow-shell-close",
    "allow-follow",
    "allow-release",
    "allow-set-start-vm-on-open",
    "allow-choose-shipyard"
  ]
}
